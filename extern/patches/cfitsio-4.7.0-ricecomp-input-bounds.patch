# torchfits: backport of upstream CFITSIO develop commit
#   4ad9d31d150976a424845cfa3e68aab3317ed561 (2026-09-18)
#   "Added input buffer length checking to the rdecomp functions."
#
# fits_rdecomp, fits_rdecomp_short and fits_rdecomp_byte only noticed that
# they had run past the end of the compressed tile after decoding a whole
# block, and the "count leading zeros" loop could read arbitrarily far: a
# truncated or corrupt RICE_1 tile was an out-of-bounds heap read. Every
# byte is now read through a bounds-checked helper and the decoders fail
# with an error instead. torchfits reaches them on every read of a RICE_1
# tile-compressed image (and of quantized float images, which are RICE_1
# by default).
#
# Drop this patch when extern/VERSIONS.txt moves to a CFITSIO release that
# contains the commit.

--- a/ricecomp.c
+++ b/ricecomp.c
@@ -30,6 +30,7 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <limits.h>
 
 /*
  * nonzero_count is lookup table giving number of bits in 8-bit values not including
@@ -75,6 +76,15 @@ static void start_outputing_bits(Buffer *buffer);
 static int done_outputing_bits(Buffer *buffer);
 static int output_nbits(Buffer *buffer, int bits, int n);
 
+static inline unsigned int safe_read_byte(unsigned char **c, unsigned char *cend)
+{
+   if (*c >= cend) {
+      ffpmsg("decompression error: buffer overrun");
+      return UINT_MAX;
+   }
+      return *(*c)++;
+}
