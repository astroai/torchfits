+/*--------------------------------------------------------------------------*/
+/* torchfits: nonzero when the absolute http/https/ftp URL in location names
+   the same host (case-insensitive) as host.  Anything else, including a
+   relative or unparsable location, counts as a different host. */
+static int net_redirect_same_host(const char *location, const char *host)
+{
+  const char *p, *end, *at, *hstart, *hend;
+  size_t n, i;
+
+  if (!strncmp(location, "http://", 7)) p = location + 7;
+  else if (!strncmp(location, "https://", 8)) p = location + 8;
+  else if (!strncmp(location, "ftp://", 6)) p = location + 6;
+  else return 0;
+
+  end = p;
+  while (*end && *end != '/' && *end != '?' && *end != '#') end++;
+  hstart = p;
+  for (at = p; at < end; at++) {
+    if (*at == '@') hstart = at + 1;
+  }
+  hend = hstart;
+  if (*hstart == '[') {
+    while (hend < end && *hend != ']') hend++;
+    if (hend < end) hend++;
+  } else {
+    while (hend < end && *hend != ':') hend++;
+  }
+  n = (size_t)(hend - hstart);
+  if (n == 0 || n != strlen(host)) return 0;
+  for (i = 0; i < n; i++) {
+    if (tolower((unsigned char)hstart[i]) != tolower((unsigned char)host[i]))
+      return 0;
+  }
+  return 1;
+}
