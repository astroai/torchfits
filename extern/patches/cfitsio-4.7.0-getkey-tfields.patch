# torchfits: backport of upstream CFITSIO develop commit
#   97f255f28e4820d27765f133e59ba4310fb379a0 (2026-10-05)
#   "Bug fix, replace a '==' with '='."
#
# ffgttb (reading an ASCII-table header) meant to fail an out-of-range
# TFIELDS with BAD_TFIELDS but compared instead of assigning, so a TABLE
# extension with TFIELDS > 999 opened as if valid. torchfits reaches it on
# every ASCII-table open; such a table now raises instead.
#
# Drop this patch when extern/VERSIONS.txt moves to a CFITSIO release that
# contains the commit.

--- a/getkey.c
+++ b/getkey.c
@@ -3405,7 +3405,7 @@ int ffgttb(fitsfile *fptr,      /* I - FITS file pointer*/
     if (ffgtkn(fptr, 8, "TFIELDS", tfields, status) == BAD_ORDER) /* 8th key*/
         return(*status = NO_TFIELDS);  /* keyword not TFIELDS */
     else if (*status == NOT_POS_INT || *tfields > 999)
-        return(*status == BAD_TFIELDS); /* bad TFIELDS value */
+        return(*status = BAD_TFIELDS); /* bad TFIELDS value */
 
 
     if (*status > 0)
