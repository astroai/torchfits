+/*--------------------------------------------------------------------------*/
+/* torchfits: the last '@' of the authority that starts at s (which ends at
+   the first '/', '?', '#' or the end of the string), or NULL when there is
+   none.  An '@' later in the path or query must not select the host. */
+static const char *net_authority_at(const char *s)
+{
+  const char *at = NULL;
+
+  for (; *s && *s != '/' && *s != '?' && *s != '#'; s++) {
+    if (*s == '@') at = s;
+  }
+  return at;
+}
