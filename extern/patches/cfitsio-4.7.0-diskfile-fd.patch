 /*--------------------------------------------------------------------------*/
+int fits_get_diskfile_fd(fitsfile *fptr)
+/*
+  torchfits: the OS file descriptor behind a handle opened through the
+  "file://" disk driver (fits_open_diskfile / fits_open_file of a plain
+  local file), or -1 for any other driver (memory, compressed, network...).
+  The descriptor belongs to CFITSIO: callers may fstat() it but must not
+  read, seek or close it.
+*/
+{
+    int driver;
+
+    if (fptr == NULL || fptr->Fptr == NULL)
+        return(-1);
+    driver = (fptr->Fptr)->driver;
+    if (driver < 0 || driver >= no_of_drivers ||
+        strcmp(driverTable[driver].prefix, "file://") != 0)
+        return(-1);
+    return(file_fileno((fptr->Fptr)->filehandle));
+}
