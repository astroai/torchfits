+int file_fileno(int handle)
+/*
+  return the descriptor of an open disk file handle, or -1
+*/
+{
+    if (handle < 0 || handle >= NMAXFILES || handleTable[handle].fileptr == 0)
+        return(-1);
+    return(fileno(handleTable[handle].fileptr));
+}
